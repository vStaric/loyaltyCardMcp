{
  "v": 1,
  "kind": "card-merge",
  "about": "Vectors for the deduplicating card union (CardMerge.kt / src/merge/cardMerge.ts). See README.md in this directory for the format.",
  "uuids": {
    "A": "aaaaaaaa-0000-4000-8000-0000000000aa",
    "F": "ffffffff-0000-4000-8000-0000000000ff"
  },
  "vectors": [
    {
      "name": "own-always-wins-and-the-format-is-part-of-the-code",
      "why": "Two cards are the same code only if they carry the same barcodeValue AND the same barcodeFormat — the same digits under two symbologies are two different cards. Own cards are emitted first and seed the seen-set, so a card we also hold never shows as somebody else's; the sharer's EAN_13 copy is dropped and their CODE_128 card survives.",
      "own": [
        {
          "id": "c-mine",
          "title": "Cafe",
          "barcodeValue": "12345",
          "barcodeFormat": "EAN_13",
          "createdAt": 1000,
          "updatedAt": 1000,
          "sortOrder": 0
        }
      ],
      "shared": [
        {
          "authorUuid": "aaaaaaaa-0000-4000-8000-0000000000aa",
          "displayName": "Bo",
          "cards": [
            {
              "id": "c-theirs-ean",
              "title": "Cafe",
              "barcodeValue": "12345",
              "barcodeFormat": "EAN_13",
              "createdAt": 1000,
              "updatedAt": 1000,
              "sortOrder": 0
            },
            {
              "id": "c-theirs-128",
              "title": "Cafe (128)",
              "barcodeValue": "12345",
              "barcodeFormat": "CODE_128",
              "createdAt": 1000,
              "updatedAt": 1000,
              "sortOrder": 1
            }
          ]
        }
      ],
      "expected": [
        { "card": "c-mine", "provenance": "own" },
        {
          "card": "c-theirs-128",
          "provenance": {
            "authorUuid": "aaaaaaaa-0000-4000-8000-0000000000aa",
            "displayName": "Bo",
            "connectionKind": "person"
          }
        }
      ]
    },
    {
      "name": "the-value-and-the-format-cannot-be-confused-for-one-another",
      "why": "The two halves of the code identity must not run together. A card whose value is literally \"12 EAN_8\" and no readable format is a DIFFERENT card from the EAN_8 card \"12\"; an implementation that builds its dedup key by concatenating the two drops one of two genuinely different cards.",
      "own": [
        {
          "id": "c-short",
          "title": "Short",
          "barcodeValue": "12",
          "barcodeFormat": "EAN_8",
          "createdAt": 1000,
          "updatedAt": 1000,
          "sortOrder": 0
        }
      ],
      "shared": [
        {
          "authorUuid": "aaaaaaaa-0000-4000-8000-0000000000aa",
          "cards": [
            {
              "id": "c-mashed",
              "title": "Mashed",
              "barcodeValue": "12 EAN_8",
              "createdAt": 1000,
              "updatedAt": 1000,
              "sortOrder": 0
            }
          ]
        }
      ],
      "expected": [
        { "card": "c-short", "provenance": "own" },
        {
          "card": "c-mashed",
          "provenance": { "authorUuid": "aaaaaaaa-0000-4000-8000-0000000000aa" }
        }
      ]
    },
    {
      "name": "photo-only-cards-never-deduplicate",
      "why": "A card with no barcodeValue carries no code and so can never be a duplicate of anything, including another codeless card. Every one is kept, and its photo pointers travel through the merge verbatim.",
